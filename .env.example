# development | test | production. In production, secure settings are the
# default and the API refuses to start with unsafe ones (see config.ts).
NODE_ENV=development

DATABASE_URL=postgres://bench:bench@localhost:5442/bench
TEST_# development | test | production. In production, secure settings are the
# default and the API refuses to start with unsafe ones (see config.ts).
NODE_ENV=development

DATABASE_URL=postgres://bench:bench@localhost:5442/bench_test

# Public URL of the web app, used to build magic links in emails.
WEB_URL=http://localhost:5173
PORT=3000

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Van Cortlandt Bench Adoption <benches@example.org>"

# HTTPS-only session cookies. Defaults to true in production, false otherwise.
# COOKIE_SECURE=true

# --- Running several API instances -----------------------------------------
# Number of proxies in front of the API (e.g. 1 behind a load balancer), so
# per-IP limits see the visitor's real address rather than the proxy's.
TRUST_PROXY_HOPS=0
# Shared store for per-IP rate limits across instances (optional).
# REDIS_URL=redis://localhost:6379
# Postgres connections per instance. Keep instances x this under the
# database's limit, or put PgBouncer / a managed pooler in front.
DB_POOL_MAX=10
