{
  "name": "@bench/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "make-admin": "tsx --env-file-if-exists=../../.env src/scripts/make-admin.ts",
    "import-benches": "tsx --env-file-if-exists=../../.env src/scripts/import-benches.ts",
    "jobs:daily": "tsx --env-file-if-exists=../../.env src/scripts/daily.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bench/shared": "*",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/etag": "^6.2.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.2",
    "@fastify/swagger-ui": "^6.1.1",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "drizzle-orm": "^0.45.3",
    "fast-json-stringify": "^7.0.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
